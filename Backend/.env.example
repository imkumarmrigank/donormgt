# Copy to Backend/.env for local development. Never commit real values.
NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Signs login sessions and file links; use a long random string in production
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Cloudinary (uploads: partner photos, Aadhaar, payment proofs)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=donormgt
MAX_UPLOAD_MB=8

# First admin, created on boot if no admin exists yet.
# Quote values that contain '#'.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional: POST /api/v1/setup/first-admin needs this secret
ADMIN_SETUP_SECRET=

# Only needed when the frontend is served from another origin
CORS_ORIGINS=http://localhost:5173
